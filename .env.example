# 変数の説明用。Pythonはこのファイルを自動読込しません。
SCS_MODE=demo
SCS_DATABASE_URL=sqlite:///./data/chat-search.db
SCS_BASE_URL=http://127.0.0.1:8000
SCS_ALLOWED_HOSTS=127.0.0.1,localhost

# 実データを使う前に統合手順を読み、integrationへ変更すること。
# SCS_MODE=integration
# SCS_BASE_URL=https://search.example.invalid
# SCS_JWT_ISSUER=https://gateway.example.invalid
# SCS_JWT_AUDIENCE=secure-chat-search-mcp
# SCS_JWT_PUBLIC_KEY_FILE=/run/secrets/gateway-public.pem
# SCS_CHATWORK_TOKEN_FILE=/run/secrets/chatwork-tokens.json
# SCS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# OFFが既定。実本文を外部へ送信するので、先に送信先・契約・費用を承認する。
SCS_ENABLE_EMBEDDINGS=false
# SCS_EMBEDDING_URL=https://embedding.example.invalid/embeddings
# SCS_EMBEDDING_MODEL=APPROVED_MODEL_NAME
# SCS_EMBEDDING_KEY=設定はSecret Manager等で行う

# Chatworkから実際に払い出されたWebhook用トークンを秘密として設定する。
# SCS_WEBHOOK_TOKEN=設定はSecret Manager等で行う
# SCS_WEBHOOK_TENANT=example-org

# 合成データ専用の既定設定。実値をこのファイルに書いてコミットしない。
SCS_MODE=demo
SCS_DATABASE_URL=sqlite:///.data/demo.sqlite3
SCS_PUBLIC_URL=http://127.0.0.1:8000
SCS_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
SCS_SEMANTIC_ENABLED=false
SCS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SCS_MODEL_CACHE=.data/models
SCS_SEMANTIC_LIMIT=5000
# gateway設定はdocs/INTEGRATION.mdを参照。キー・トークンは秘密専用マウントへ。
